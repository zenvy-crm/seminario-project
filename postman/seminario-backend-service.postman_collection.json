{
  "info": {
    "name": "seminario-backend-service",
    "description": "API REST del backend (auth JWT + MFA, usuarios, perfil, documentos, auditoria). Importar junto con el environment 'seminario-backend-service.postman_environment.json'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "mfaToken", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "documentId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Registro",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "firstName", "value": "Juan", "type": "text" },
                { "key": "lastName", "value": "Perez", "type": "text" },
                { "key": "username", "value": "jperez", "type": "text" },
                { "key": "email", "value": "jperez@example.com", "type": "text" },
                { "key": "phone", "value": "88887777", "type": "text" },
                { "key": "birthDate", "value": "1995-05-20", "type": "text" },
                { "key": "identification", "value": "1234567890", "type": "text" },
                { "key": "password", "value": "Password#123", "type": "text" },
                { "key": "confirmPassword", "value": "Password#123", "type": "text" },
                { "key": "document", "type": "file", "src": [], "disabled": true }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.requiresMfa && res.data && res.data.mfaToken) {",
                  "    pm.collectionVariables.set('mfaToken', res.data.mfaToken);",
                  "    console.log('mfaToken guardado. Revisa la consola del backend para el codigo OTP.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin#2026!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Verificar MFA",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', res.data.accessToken);",
                  "    if (res.data.user && res.data.user.id) { pm.collectionVariables.set('userId', res.data.user.id); }",
                  "    console.log('accessToken guardado en la coleccion.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mfaToken\": \"{{mfaToken}}\",\n  \"code\": \"REEMPLAZAR_CON_EL_CODIGO_DE_LA_CONSOLA\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/mfa/verify", "host": ["{{baseUrl}}"], "path": ["api", "auth", "mfa", "verify"] }
          }
        },
        {
          "name": "Refresh",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": { "mode": "raw", "raw": "" },
            "url": { "raw": "{{baseUrl}}/api/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "auth", "refresh"] },
            "description": "Usa la cookie httpOnly 'refreshToken' que Postman guarda automaticamente tras login/mfa/verify (cookie jar habilitado)."
          }
        },
        {
          "name": "Logout",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": { "mode": "raw", "raw": "" },
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "Usuarios (ADMIN)",
      "item": [
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/users?search=&role=&status=&page=1&pageSize=20&sortBy=&sortDir=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"],
              "query": [
                { "key": "search", "value": "" },
                { "key": "role", "value": "" },
                { "key": "status", "value": "" },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" },
                { "key": "sortBy", "value": "" },
                { "key": "sortDir", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Obtener usuario por id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"] }
          }
        },
        {
          "name": "Crear usuario",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Maria\",\n  \"lastName\": \"Lopez\",\n  \"username\": \"mlopez\",\n  \"email\": \"mlopez@example.com\",\n  \"phone\": \"88886666\",\n  \"birthDate\": \"1990-01-15\",\n  \"identification\": \"0987654321\",\n  \"password\": \"Password#123\",\n  \"role\": \"USER\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
          }
        },
        {
          "name": "Actualizar usuario",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"88889999\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"] }
          }
        },
        {
          "name": "Cambiar estado",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"INACTIVE\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}", "status"] }
          }
        },
        {
          "name": "Cambiar rol",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"ADMIN\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}/role", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}", "role"] }
          }
        }
      ]
    },
    {
      "name": "Documentos",
      "item": [
        {
          "name": "Listar documentos de un usuario",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}/documents", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}", "documents"] }
          }
        },
        {
          "name": "Subir documento",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.id) { pm.collectionVariables.set('documentId', res.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": [] }]
            },
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}/documents", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}", "documents"] }
          }
        },
        {
          "name": "Eliminar documento",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}/documents/{{documentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{userId}}", "documents", "{{documentId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Perfil",
      "item": [
        {
          "name": "Obtener mi perfil",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/profile", "host": ["{{baseUrl}}"], "path": ["api", "profile"] }
          }
        },
        {
          "name": "Actualizar mi perfil",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"88881111\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/profile", "host": ["{{baseUrl}}"], "path": ["api", "profile"] }
          }
        },
        {
          "name": "Cambiar contrasena",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Admin#2026!\",\n  \"newPassword\": \"NuevaPassword#123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/profile/change-password", "host": ["{{baseUrl}}"], "path": ["api", "profile", "change-password"] }
          }
        }
      ]
    }
  ]
}
