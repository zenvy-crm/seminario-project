# =============================================================================
# Variables de entorno del contenedor seminario-api (docker-compose.yml).
# Copiar como "api.env" y completar. NUNCA subir "api.env" a control de versiones.
# deploy.ps1 lo genera automaticamente a partir del .env local si no existe.
# =============================================================================

ASPNETCORE_ENVIRONMENT=Production

# --- SQL Server: se resuelve por nombre de contenedor dentro de la red db-infra ---
ConnectionStrings__DefaultConnection=Server=mssql-relational,1433;Database=SeminarioDb;User Id=sa;Password=CAMBIAR;TrustServerCertificate=True;

# --- MongoDB (auditoria) ---
MongoDB__ConnectionString=mongodb://admin:CAMBIAR@mongo-nosql:27017/?authSource=admin
MongoDB__DatabaseName=SeminarioAudit
MongoDB__AuditCollection=audit_logs

# --- JWT ---
Jwt__Secret=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO
Jwt__Issuer=SeminarioBackendService
Jwt__Audience=SeminarioFrontend
Jwt__ExpirationMinutes=30
Jwt__RefreshTokenExpirationDays=7

# --- CORS: origen desde el que el navegador carga el frontend ---
Cors__AllowedOrigin=http://localhost:5173
