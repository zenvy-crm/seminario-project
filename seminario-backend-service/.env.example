# =============================================================================
# Variables de entorno - seminario-backend-service
# Copiar este archivo como ".env" y completar con valores reales.
# NUNCA subir el archivo ".env" a control de versiones.
# =============================================================================

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

# --- Base de datos relacional (SQL Server) ---
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=SeminarioDb;User Id=sa;Password=CAMBIAR;TrustServerCertificate=True;

# --- MongoDB (auditoria) ---
MongoDB__ConnectionString=mongodb://admin:CAMBIAR@localhost:27017/?authSource=admin
MongoDB__DatabaseName=SeminarioAudit
MongoDB__AuditCollection=audit_logs

# --- JWT ---
Jwt__Secret=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO
Jwt__Issuer=SeminarioBackendService
Jwt__Audience=SeminarioFrontend
Jwt__ExpirationMinutes=30
Jwt__RefreshTokenExpirationDays=7

# --- CORS (origen del frontend React) ---
Cors__AllowedOrigin=http://localhost:5173
